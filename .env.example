# Copy to .env. You need exactly ONE free key — no credit card.
#
#   GROQ_API_KEY  ->  https://console.groq.com/keys   (sign in with Google, instant)
#
# It powers: the agent (classify + draft) and Judge A = qwen/qwen3.8-27b, and
# Judge B = allam-2-7b (a different model lineage). Retrieval is local TF-IDF —
# no embedding API. See config.yaml to change models.
#
# The committed llm-cache.tgz (unpacked by `make setup`) replays every call, so
# `make all` reproduces the headline numbers with NO key. A live re-run takes
# ~15-20 min the first time because Groq's free tier is ~30 req/min per model;
# every run after that is instant.

GROQ_API_KEY=

# Optional — other providers work too if you'd rather use them for a judge:
# GEMINI_API_KEY=      # then set judge_b: {provider: gemini, model: gemini-3.6-flash}
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional knobs
# TRUSTAGENT_OFFLINE=0
# TRUSTAGENT_WORKERS=8
# TRUSTAGENT_GROQ_INTERVAL=2.05   # seconds between calls to one Groq model
